# Week 1 environment template
# Copy to .env and adjust as needed.

# OpenAI API (required for later weeks; Week 1 checks presence only)
OPENAI_API_KEY=sk-your-openai-key

# Postgres connection (local compose)
DATABASE_URL=postgresql://umca:umcapassword@localhost:5432/umca

# Redis connection (local compose)
# Note: Using 6380 on host to avoid conflicts.
REDIS_URL=redis://localhost:6380

# MinIO endpoint and credentials (local compose)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Observability (OTLP gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Grafana (local compose)
GRAFANA_URL=http://localhost:3001
