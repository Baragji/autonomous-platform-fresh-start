{
  "name": "autonomous-platform",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npm-run-all --parallel dev:gateway dev:mca dev:planner",
    "dev:gateway": "npm --prefix packages/gateway run dev",
    "dev:mca": "npm --prefix packages/mca run dev",
    "dev:planner": "npm --prefix packages/planner run dev",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.base.json --noEmit && npm --prefix packages/gateway run typecheck && npm --prefix packages/mca run typecheck && npm --prefix packages/planner run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "turbo": "^2.2.2",
    "typescript": "^5.6.3",
    "npm-run-all": "^4.1.5",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "vitest": "^2.1.4",
    "@vitest/coverage-v8": "^2.1.4",
    "@types/node": "^22.7.4",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.55.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "langfuse": "^3.21.0"
  }
}
