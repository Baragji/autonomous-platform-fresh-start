{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "types": ["node", "vitest"],
    "paths": {
      "@autonomous/shared": ["./packages/shared/src/index"],
      "@autonomous/shared/*": ["./packages/shared/src/*"],
      "@autonomous/vfs": ["./packages/vfs/src/index"],
      "@autonomous/vfs/*": ["./packages/vfs/src/*"]
    }
  }
}

